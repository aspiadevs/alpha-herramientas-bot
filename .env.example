# API de Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Meta (WhatsApp, Instagram, Facebook)
META_ACCESS_TOKEN=          # Token permanente de System User
WHATSAPP_PHONE_ID=          # Phone Number ID del número de WhatsApp Business
WEBHOOK_VERIFY_TOKEN=       # String random para verificar webhook de Meta

# Jumpseller (tienda)
JUMPSELLER_LOGIN=           # Login key de la API
JUMPSELLER_TOKEN=           # Auth token (32 caracteres)

# Límite de gasto mensual en USD para Claude (default: 15)
MONTHLY_AI_BUDGET=15
